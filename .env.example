# ─────────────────────────────────────────────────────────────────────────
# Alpaca API Credentials
# ─────────────────────────────────────────────────────────────────────────
# Get these from https://app.alpaca.markets/signup (paper trading account)
# Paper trading is the DEFAULT. To enable live trading, change PAPER_MODE=false
# and use live API keys (⚠️  HIGH RISK).

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Paper trading URL (default — no need to change for paper)
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
# Live URL (use ONLY when PAPER_MODE=false):
# ALPACA_BASE_URL=https://api.alpaca.markets

# Alpaca Data URL (for market data)
ALPACA_DATA_URL=https://data.alpaca.markets

# Market data feed:
#   iex = free plan (real-time IEX data). RECOMMENDED for free accounts.
#   sip = consolidated feed (requires a paid Alpaca market data subscription).
# The free plan CANNOT query recent SIP data and will return HTTP 403, so keep
# this as "iex" unless you have a paid subscription.
ALPACA_DATA_FEED=iex

# ─────────────────────────────────────────────────────────────────────────
# Trading Mode
# ─────────────────────────────────────────────────────────────────────────
# Set to false ONLY if you understand the risks and want to trade with real money.
# DEFAULT: true (paper trading)
PAPER_MODE=true

# ─────────────────────────────────────────────────────────────────────────
# Assets to Trade
# ─────────────────────────────────────────────────────────────────────────
# Comma-separated list of stock/ETF symbols.
# Large-cap, liquid ETFs are recommended for the mean-reversion strategy.
ASSETS=SPY,QQQ,GLD,IWM

# ─────────────────────────────────────────────────────────────────────────
# Strategy Parameters (Mean Reversion)
# ─────────────────────────────────────────────────────────────────────────
# SMA periods
SMA_SHORT=20
SMA_LONG=50

# RSI settings
RSI_PERIOD=14
RSI_OVERSOLD=40
RSI_OVERBOUGHT=70

# Bollinger Bands
BB_PERIOD=20
BB_STD_DEV=1.8

# Bar timeframe (e.g., 15Min, 5Min, 1Hour, 1Day)
BAR_TIMEFRAME=15Min

# How often to check for signals (in minutes)
CHECK_INTERVAL_MINUTES=5

# Evaluate signals only on the last CLOSED bar, discarding the still-forming
# current bar. Recommended with the IEX feed, whose thinner volume makes the
# forming bar's close noisier and can trigger premature/flipping signals.
#   true  = act on confirmed, closed bars (safer, slightly delayed)
#   false = act on the live forming bar (faster, noisier)
USE_CLOSED_BARS_ONLY=true

# Entry execution
# true  = limit entry (caps slippage; may not fill if price runs away)
# false = market entry (always fills, but at whatever the market price is)
USE_LIMIT_ENTRY=true
# Buffer above the signal price for BUY limit entries (% of price). Lets small
# upticks still fill while capping the worst-case entry slippage.
ENTRY_LIMIT_BUFFER_PCT=0.25

# ─────────────────────────────────────────────────────────────────────────
# Risk Management (Hard Limits)
# ─────────────────────────────────────────────────────────────────────────
# Maximum % of portfolio value per single position
MAX_POSITION_SIZE_PCT=7.5

# Maximum % of portfolio in all open positions combined
MAX_TOTAL_EXPOSURE_PCT=30.0

# Stop-loss % below entry price (for long positions)
STOP_LOSS_PCT=2.0

# Take-profit % above entry price (for long positions)
TAKE_PROFIT_PCT=3.5

# Maximum daily portfolio loss % before halting all trading
MAX_DAILY_LOSS_PCT=3.0

# Max consecutive losing trades before a cooldown period
MAX_CONSECUTIVE_LOSSES=3

# Cooldown duration in minutes after consecutive losses
CONSECUTIVE_LOSS_COOLDOWN_MINUTES=120

# ─────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG
